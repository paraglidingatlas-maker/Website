<!doctype html><html><head><meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;1,800;1,900&family=Barlow:wght@500;600;700&display=block" rel="stylesheet">
<style>
:root{--g:#006847;--r:#ce1126;--o:#ff7517}
*{box-sizing:border-box;margin:0}
html,body{width:3840px;height:2160px;overflow:hidden;background:transparent;font-family:"Barlow Condensed",sans-serif}
.panel{position:absolute;left:180px;top:170px;width:2300px;padding:90px 110px 80px;background:linear-gradient(180deg,rgba(8,34,24,.94),rgba(6,24,18,.94));box-shadow:0 40px 120px rgba(0,0,0,.5)}
.tri{position:absolute;left:0;top:0;bottom:0;width:28px;background:linear-gradient(180deg,var(--g) 0 33.3%,#fff 33.3% 66.6%,var(--r) 66.6%)}
.kick{color:#fff;font:800 italic 64px/1 "Barlow Condensed";letter-spacing:.16em;text-transform:uppercase;opacity:.9}
.kick b{color:var(--o)}
.title{color:#fff;font:900 italic 220px/.9 "Barlow Condensed";text-transform:uppercase;margin:18px 0 50px}
.title span{color:var(--o)}
.row{display:grid;grid-template-columns:150px 110px 1fr 520px 300px;align-items:center;gap:36px;height:126px;border-top:3px solid rgba(255,255,255,.1);color:#fff}
.row .rk{font:900 italic 96px/1 "Barlow Condensed";color:rgba(255,255,255,.75);text-align:right}
.row.p1 .rk,.row.p2 .rk,.row.p3 .rk{color:var(--o)}
.row img{width:96px;height:64px;object-fit:cover;border-radius:6px;box-shadow:0 0 0 3px rgba(0,0,0,.3)}
.row .nm{font:800 italic 84px/1 "Barlow Condensed";text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .gl{font:600 46px/1 "Barlow";color:rgba(255,255,255,.7);letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .sc{font:800 78px/.95 "Barlow Condensed";text-align:right}
.row .sc small{display:block;font:600 34px/1 "Barlow";color:rgba(255,255,255,.65);margin-top:4px}
.foot{margin-top:40px;color:rgba(255,255,255,.7);font:600 44px/1.2 "Barlow";letter-spacing:.06em}
.lock{position:absolute;right:120px;top:110px;display:flex;align-items:center;gap:60px;filter:drop-shadow(0 6px 24px rgba(0,0,0,.6))}
.lock .l-srs{width:420px}.lock i{display:block;width:8px;height:230px;background:rgba(255,255,255,.75)}
.lock .l-adv{display:flex;flex-direction:column;align-items:center;gap:16px;color:#fff;font:700 62px/1.05 "Barlow";letter-spacing:.32em;text-transform:uppercase;text-align:center}
.lock .l-adv img{width:230px}
/* winner card */
.win{position:absolute;left:180px;bottom:260px;display:flex;flex-direction:column;filter:drop-shadow(0 30px 80px rgba(0,0,0,.5))}
.win .k{align-self:flex-start;background:var(--o);color:#111;font:800 italic 80px/1 "Barlow Condensed";letter-spacing:.1em;text-transform:uppercase;padding:22px 50px}
.win .n{background:#fff;color:#111;font:900 italic 230px/1 "Barlow Condensed";text-transform:uppercase;padding:20px 70px 10px 60px;display:flex;align-items:center;gap:50px;white-space:nowrap}
.win .n img{height:150px;border-radius:10px}
.win .s{align-self:flex-start;background:rgba(8,34,24,.94);color:#fff;font:700 64px/1 "Barlow";letter-spacing:.08em;padding:30px 60px;display:flex;gap:50px}
.win .s b{color:var(--o)}
</style></head><body>BODY</body></html>
